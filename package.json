{
  "name": "diploma",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "check": "tsx src/scripts/check.ts",
    "check:prod": "node dist/scripts/check.js",
    "typecheck": "tsc --noEmit",
    "extract": "tsx src/scripts/extract.ts",
    "chunk": "tsx src/scripts/chunk.ts",
    "ingest": "tsx src/scripts/ingest.ts",
    "search": "tsx src/scripts/search.ts",
    "ask": "tsx src/scripts/ask.ts",
    "prebuild": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f qdrant"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@qdrant/js-client-rest": "^1.20.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "ollama": "^0.6.4",
    "unpdf": "^1.9.1",
    "zod": "^4.6.7"
  },
  "overrides": {
    "undici": "^7.30.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
